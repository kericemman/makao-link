NODE_ENV=production
HOST=0.0.0.0
PORT=5002

MONGO_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_COOKIE_DOMAIN=.rendahomes.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASIC_PLAN=
PAYSTACK_PREMIUM_PLAN=
PAYSTACK_PRO_PLAN=
# Configure these Paystack monthly plans at VAT-inclusive totals: Basic KES 580,
# Premium KES 1,740, Pro KES 2,900. Keep plan interval monthly and currency KES.
PAYSTACK_WHATSAPP_SUPPORT=
LANDLORD_ONBOARDING_FOLLOWUP_ENABLED=false
LANDLORD_ONBOARDING_FOLLOWUP_DELAY_HOURS=24
PAYSTACK_CALLBACK_URL=https://landlord.rendahomes.com/payment/callback

RESEND_API_KEY=
EMAIL_FROM=RendaHomes <hello@rendahomes.com>
ADMIN_EMAIL=

CLIENT_URL=https://rendahomes.com
CLIENT_URLS=https://rendahomes.com,https://www.rendahomes.com,https://landlord.rendahomes.com,https://user.rendahomes.com,https://app.rendahomes.com
LANDLORD_CLIENT_URL=https://landlord.rendahomes.com
USER_CLIENT_URL=https://user.rendahomes.com
ADMIN_CLIENT_URL=https://app.rendahomes.com
LANDLORD_URL=https://landlord.rendahomes.com
USER_URL=https://user.rendahomes.com

# Initial admin seeding only. Do not keep weak values in production.
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Google sign-in verification (comma-separated web/mobile client IDs)
GOOGLE_OAUTH_CLIENT_IDS=

# Renda Assistant remains disabled until provider contracts and secrets are reviewed.
RENDA_ASSISTANT_ENABLED=false
RENDA_ASSISTANT_RETENTION_DAYS=90
RENDA_ASSISTANT_LIVE_TRANSPORT_ENABLED=false
WHATCHIMP_ENABLED=false
WHATCHIMP_API_KEY=
WHATCHIMP_PHONE_NUMBER_ID=
WHATCHIMP_WEBHOOK_ENABLED=false
# Receive-only diagnostics write sanitized metadata to the dedicated diagnostic collection.
WHATCHIMP_WEBHOOK_DIAGNOSTIC_ENABLED=false
# Generate a unique 32-byte+ random token; configure the callback as
# /api/webhooks/whatchimp/<token>. Never paste it into logs or source control.
WHATCHIMP_WEBHOOK_TOKEN=
RENDA_ASSISTANT_STATUS_NOTIFICATIONS_ENABLED=false
RENDA_ASSISTANT_CONSENT_POLICY_VERSION=renda-wa-v1
RENDA_ASSISTANT_MOBILE_SESSION_DAYS=30
RENDA_ASSISTANT_MOBILE_CONSENT_POLICY_VERSION=renda-mobile-v1
RENDA_ASSISTANT_WEB_SESSION_DAYS=30
RENDA_ASSISTANT_WEB_CONSENT_POLICY_VERSION=renda-web-v1
OPENAI_API_KEY=
RENDA_ASSISTANT_MODEL=
RENDA_ASSISTANT_TIMEOUT_MS=15000

# Migration scripts require a dedicated disposable/non-production database.
MONGO_URI_STAGING=
RENDA_IDENTITY_MIGRATION_TARGET=
RENDA_APP_ALERT_INDEX_MIGRATION_TARGET=
MONGO_STAGING_ALLOWED_HOSTS=
MONGO_STAGING_DB_USER=



# Do not put credential values in this example file. Configure local secrets in .env.

# Cloudflare R2 storage. Use a public bucket/domain only for approved property media.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BUCKET=your-public-bucket-name
R2_PUBLIC_BUCKET_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Optional dedicated public-bucket credentials; otherwise the shared R2 credentials above are used.
R2_PUBLIC_BUCKET_ACCESS_KEY_ID=
R2_PUBLIC_BUCKET_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://your-public-media-domain

# Private R2 storage for KYC and agent application documents.
R2_PRIVATE_BUCKET=your-private-bucket-name
R2_PRIVATE_BUCKET_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET_ACCESS_KEY_ID=your-private-r2-access-key-id
R2_PRIVATE_BUCKET_SECRET_ACCESS_KEY=your-private-r2-secret-access-key
